{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "club-ranch-training-signup",
  "main": "index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "vars": {
    "LOCAL_PREVIEW": "false",
    "RIDER_RECEIPTS_ENABLED": "true"
  },
  "routes": [
    {
      "pattern": "clubranchmx.com/api/training-signup/",
      "zone_name": "clubranchmx.com"
    },
    {
      "pattern": "www.clubranchmx.com/api/training-signup/",
      "zone_name": "clubranchmx.com"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "post@clubranchmx.com"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "SIGNUP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-ranch-riders",
      "database_id": "4e2fe83b-0d32-4810-bb7b-798fdb74bf50",
      "migrations_dir": "migrations"
    }
  ]
}
