---
import Icon from './Icon.astro';
---
<section class="welcome-banner" aria-labelledby="welcome-heading">
  <img class="hero-backdrop" src="/images/club-ranch-welcome-wide-poster.jpg" width="1280" height="720" alt="" fetchpriority="high"/>
  <video class="hero-backdrop hero-background-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="welcome-film wrap">
    <div class="welcome-film-copy">
      <h1 id="welcome-heading">Welcome to<br/>the <em>ranch.</em></h1>
      <p class="welcome-film-description">Colorado motocross training at Club Ranch MX. A place for riding, community, and your next day on the bike.</p>
      <div class="welcome-film-actions"><a class="button" href="#training">Find your next ride <Icon/></a><a class="text-link film-link" href="/videos/club-ranch-welcome-wide.mp4" data-open-film aria-haspopup="dialog">Watch the film <Icon name="sound"/></a></div>
      <p class="welcome-film-signoff">A little dirt. A lot of drive.</p>
    </div>
    <button class="background-toggle" type="button" hidden aria-label="Play background video"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path data-background-symbol d="M8 5v14l11-7z"/></svg><span>Play background</span></button>
  </div>
</section>
<dialog class="film-viewer" aria-labelledby="film-viewer-title">
  <div class="film-viewer-header"><h2 id="film-viewer-title">A look around the ranch</h2><button type="button" data-close-film aria-label="Close welcome film" autofocus><Icon name="close"/></button></div>
  <video id="welcome-video" width="1280" height="720" poster="/images/club-ranch-welcome-wide-poster.jpg" preload="none" playsinline controls aria-label="Club Ranch MX welcome film">
    Your browser does not support this video. <a href="/videos/club-ranch-welcome-wide.mp4">Watch the ranch film.</a>
  </video>
  <p class="film-error" hidden role="status">The film couldn’t load. <a href="/videos/club-ranch-welcome-wide.mp4">Open the video directly.</a></p>
</dialog>
<script>
  const background = document.querySelector<HTMLVideoElement>('.hero-background-video');
  const toggle = document.querySelector<HTMLButtonElement>('.background-toggle');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let wantsMotion = !motion.matches;
  let heroVisible = true;
  const syncBackground = () => {
    if (!background) return;
    if (!wantsMotion || !heroVisible || document.hidden || document.querySelector<HTMLDialogElement>('.film-viewer')?.open) { background.pause(); return; }
    if (!background.src) background.src = '/videos/club-ranch-welcome-wide.mp4';
    background.muted = true;
    background.play().catch(() => { /* Poster and explicit play control remain available. */ });
  };
  if (background && toggle) {
    toggle.hidden = false;
    const updateControl = () => {
      const playing = !background.paused;
      toggle.setAttribute('aria-label', playing ? 'Pause background video' : 'Play background video');
      toggle.querySelector('span')!.textContent = playing ? 'Pause background' : 'Play background';
      toggle.querySelector('path')!.setAttribute('d', playing ? 'M6 5h4v14H6zM14 5h4v14h-4z' : 'M8 5v14l11-7z');
    };
    background.addEventListener('play', updateControl);
    background.addEventListener('pause', updateControl);
    background.addEventListener('playing', () => background.classList.add('is-playing'));
    background.addEventListener('error', () => { background.classList.remove('is-playing'); toggle.hidden = true; });
    toggle.addEventListener('click', () => { wantsMotion = background.paused; syncBackground(); });
    motion.addEventListener('change', () => { wantsMotion = !motion.matches; syncBackground(); if (motion.matches) background.classList.remove('is-playing'); });
    new IntersectionObserver(entries => { heroVisible = entries[0].isIntersecting; syncBackground(); }, { threshold:0.05 }).observe(document.querySelector('.welcome-banner')!);
    document.addEventListener('visibilitychange', syncBackground);
    syncBackground();
  }
  const video = document.querySelector<HTMLVideoElement>('#welcome-video');
  const viewer = document.querySelector<HTMLDialogElement>('.film-viewer');
  if (video && viewer && typeof viewer.showModal === 'function') {
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-open-film]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        viewer.showModal();
        syncBackground();
        if (!video.getAttribute('src')) video.src = link.href;
        video.play().catch(() => { /* Native controls remain available if playback is blocked. */ });
      });
    });
    viewer.querySelector('[data-close-film]')?.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', event => {
      const bounds = viewer.getBoundingClientRect();
      if (event.target === viewer && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) viewer.close();
    });
    viewer.addEventListener('close', () => { video.pause(); opener?.focus({ preventScroll:true }); syncBackground(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) video.pause(); });
    video.addEventListener('error', () => viewer.querySelector('.film-error')?.removeAttribute('hidden'));
  }
</script>
<style>
  .welcome-banner { position:relative; isolation:isolate; background:#0b1721; color:#f5f3ec; margin-bottom:40px; overflow:hidden; }
  .hero-backdrop { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; z-index:-3; }
  .hero-background-video { opacity:0; }
  .hero-background-video.is-playing { opacity:1; }
  .hero-shade { position:absolute; inset:0; z-index:-2; background:linear-gradient(90deg,rgba(4,15,23,.8) 0%,rgba(4,15,23,.58) 48%,rgba(4,15,23,.2) 100%),linear-gradient(0deg,rgba(4,15,23,.75),transparent 55%); }
  .welcome-film { position:relative; min-height:calc(100svh - 96px); display:flex; align-items:center; padding-block:88px 110px; }
  .welcome-film-copy { max-width:690px; }
  h1 { font-size:clamp(72px,7vw,96px); line-height:.95; letter-spacing:-.02em; color:#f5f3ec; }
  h1 em { display:inline-block; color:#ff9855; font-weight:700; white-space:nowrap; transform-origin:center; }
  .welcome-film-description { margin-top:28px; font-size:18px; line-height:1.7; max-width:48ch; color:#f5f3ec; }
  .welcome-film-actions { display:flex; flex-wrap:wrap; align-items:center; gap:28px; margin-top:32px; }
  .welcome-film-actions .button { background:#ff9855; color:#0b2335; }
  .welcome-film-actions .button:hover { background:#ffad77; }
  .film-link { color:#f5f3ec; gap:12px; min-height:48px; border-color:#f5f3ec; }
  .welcome-film-signoff { font-family:var(--display); font-size:25px; line-height:1.3; color:#f5f3ec; margin-top:32px; }
  .background-toggle { position:absolute; bottom:26px; left:0; display:flex; align-items:center; gap:10px; border:1px solid #ffffff70; border-radius:6px; padding:10px 13px; min-height:44px; color:#fff; background:#07151bd9; font-size:12px; }
  .background-toggle[hidden] { display:none; }
  .background-toggle:hover { background:#0b2335; }
  .welcome-banner :focus-visible { outline-color:#ff9855; }
  @media(prefers-reduced-motion:no-preference) { h1 em { animation:ranch-arrival .95s cubic-bezier(.16,1,.3,1) .15s both; } }
  @keyframes ranch-arrival { 0% {transform:scale(1);} 42% {transform:scale(1.12);} 100% {transform:scale(1);} }
  .film-viewer { margin:auto; padding:12px; width:min(1200px,calc(100vw - 24px)); max-width:calc(100vw - 24px); max-height:calc(100dvh - 24px); border-radius:14px; overflow:auto; }
  .film-viewer::backdrop { background:rgba(4,15,23,.88); }
  .film-viewer-header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-bottom:10px; }
  .film-viewer-header h2 { font-size:23px; }
  .film-viewer-header button { display:grid; place-items:center; width:44px; height:44px; flex-shrink:0; border:1px solid var(--line); border-radius:50%; background:var(--surface); color:var(--ink); cursor:pointer; }
  .film-viewer video { display:block; width:100%; height:auto; max-height:calc(100dvh - 110px); aspect-ratio:16 / 9; object-fit:contain; background:#0b1721; border-radius:6px; }
  .film-error { font-size:12px; margin-top:12px; }
  .film-error a { text-decoration:underline; }
  @media(max-width:760px) {
    .welcome-banner { margin-bottom:24px; }
    .welcome-film { min-height:calc(100svh - 82px); padding-block:64px 100px; }
    h1 { font-size:clamp(64px,13vw,86px); }
    .welcome-film-description { font-size:15px; margin-top:24px; max-width:35ch; }
    .welcome-film-actions { gap:18px 24px; margin-top:26px; }
    .welcome-film-signoff { font-size:23px; margin-top:26px; }
    .hero-shade { background:linear-gradient(90deg,rgba(4,15,23,.72),rgba(4,15,23,.45)),linear-gradient(0deg,rgba(4,15,23,.8),transparent 65%); }
    .background-toggle { bottom:22px; }
  }
</style>
