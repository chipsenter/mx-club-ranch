---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import EventSection from '../components/EventSection.astro';
import { site, heroSlides, upcomingEvents, pastEvents, trainingSessions, swagItems, eventPhotos } from '../data/site';
const phoneHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
const links = [['Training', '#training'], ['Upcoming events', '#events'], ['Past events', '#stories'], ['Event photos', '#photos'], ['Ranch swag', '#swag'], ['Contact us', '#contact']];
const safeHttps = (value: string) => { try { return new URL(value).protocol === 'https:'; } catch { return false; } };
const hasBooking = safeHttps(site.bookingUrl);
const hasEmbed = hasBooking && safeHttps(site.bookingEmbedUrl);
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={site.description}/><meta name="theme-color" content="#e7e6dd"/>
  <script is:inline>
    // Apply the saved preference before the first paint, including when storage is unavailable.
    try {
      const theme = localStorage.getItem('mx-club-ranch-theme') === 'dark' ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#172b3a' : '#e7e6dd');
    } catch {}
  </script>
  <meta property="og:title" content={site.name}/><meta property="og:description" content={site.description}/><meta property="og:type" content="website"/>
  <title>MX Club Ranch — Motocross training & events</title>
  <link rel="icon" type="image/png" href="/images/club-ranch-logo.png"/>
  <link rel="preload" as="image" href={heroSlides[0]?.image}/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="header-band"><div class="site-header wrap">
  <a href="#" class="brand" aria-label="MX Club Ranch home"><img src="/images/club-ranch-logo.png" alt="Club Ranch MX logo" width="355" height="367"/><span>MX CLUB RANCH<small>Motocross. Together.</small></span></a>
  <div class="header-actions"><a class="header-book" href="#training">Plan your ride <Icon/></a>
    <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark view" hidden>
      <Icon name="moon" class="theme-moon"/><Icon name="sun" class="theme-sun"/><span data-theme-label>Dark</span>
    </button>
    <details class="menu"><summary>Menu <Icon name="menu"/></summary><nav aria-label="Main navigation">{links.map(([label, href]) => <a href={href}>{label}<Icon/></a>)}<div class="menu-contact">{site.phone && <a href={phoneHref}>{site.phone}</a>}{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}{!site.phone && !site.email && <p>Contact details coming soon.</p>}</div></nav></details>
  </div>
</div></header>
<main id="main">
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-copy"><h1 id="hero-heading">A little dirt.<br/>A lot of <em>drive.</em></h1><p>Welcome to MX Club Ranch.<br/>A place for motocross, training,<br class="desktop-break"/> and your next day on the bike.</p><a class="button" href="#training">Find your next ride <Icon/></a><a class="hero-secondary" href="#events">See what’s coming up</a></div>
    <div class="hero-media" role="region" aria-roledescription="carousel" aria-label="Motocross gallery">
      <div class="slides">{heroSlides.map((slide, index) => <figure class:list={['slide', { active: index === 0 }]} data-slide aria-hidden={index === 0 ? 'false' : 'true'} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${heroSlides.length}`}>
        <img src={slide.image} alt={slide.alt} width="1600" height="1100" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'}/><figcaption><span>{slide.caption}</span><small>{slide.credit}</small></figcaption>
      </figure>)}</div>
      {heroSlides.length > 1 && <div class="carousel-controls"><span id="slide-count" aria-live="polite">1 / {heroSlides.length}</span><div><button class="icon-button previous" data-carousel-prev aria-label="Previous photo"><Icon name="chevron"/></button><button class="icon-button" data-carousel-next aria-label="Next photo"><Icon name="chevron"/></button></div></div>}
    </div>
  </section>
  <div class="welcome-strip wrap"><span>Two wheels. One shared passion.</span><a href="#training">Let’s get riding <Icon/></a></div>
  <section id="training" class="training-section wrap" aria-labelledby="training-heading">
    <div class="section-heading"><h2 id="training-heading">Your next chapter.<br/>On two wheels.</h2><p>Make time for the ride. Explore the training calendar and find your next opportunity to get on the track.</p></div>
    <div class="training-layout">
      <div class="training-copy"><Icon name="calendar"/><h3>Train at the ranch.</h3><p>A dedicated space to plan your training, keep an eye on new dates, and take the next step in your riding.</p><div class="booking-state"><span class="status-label">{hasBooking ? 'Book your training' : 'Training schedule coming soon'}</span><p>{hasBooking ? 'Choose an available session in our booking calendar. Your reservation is confirmed by the booking provider.' : 'New training dates will appear here when registration opens. Check back for the next chance to ride.'}</p></div>
      {hasBooking ? <a class="button" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Open booking calendar <Icon name="external"/></a> : <a class="text-link" href="#contact">Keep in touch <Icon/></a>}
      </div>
      <div class="calendar" data-calendar data-sessions={JSON.stringify(trainingSessions)}>
        <div class="calendar-top"><h3 id="calendar-month">Training calendar</h3><div class="calendar-actions"><button class="calendar-today" data-today>Today</button><button class="icon-button previous" data-month-prev aria-label="Previous month"><Icon name="chevron"/></button><button class="icon-button" data-month-next aria-label="Next month"><Icon name="chevron"/></button></div></div>
        <div class="calendar-week" aria-hidden="true">{['M','T','W','T','F','S','S'].map(day => <span>{day}</span>)}</div>
        <div class="calendar-days" id="calendar-days" role="group" aria-labelledby="calendar-month"></div>
        <p class="calendar-legend"><span></span> Training date <span class="today-key"></span> Today</p>
        <div id="calendar-result" class="calendar-result" aria-live="polite"><p>Choose a date to explore training.</p></div>
        <noscript><p>Enable JavaScript to browse the calendar. {hasBooking ? <a href={site.bookingUrl}>Open the booking page.</a> : 'Training dates will be announced soon.'}</p></noscript>
      </div>
    </div>
    {hasEmbed && <details class="booking-embed"><summary>Book here on the page <Icon name="chevron"/></summary><p>Booking is provided by an external service. <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Open it in a new tab</a> if it does not load.</p><iframe data-src={site.bookingEmbedUrl} title="Book MX Club Ranch training" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></details>}
  </section>
  <div class="wrap"><EventSection id="events" title="Next up at the ranch." intro="A reason to get together. A reason to ride. Keep an eye on what’s ahead." events={upcomingEvents}/></div>
  <div class="past-band"><div class="wrap"><EventSection id="stories" title="From the rearview." intro="A look back at the days that brought us together. More than laps. Memories." events={pastEvents} past/></div></div>
  <section id="photos" class="photos-section wrap" aria-labelledby="photos-heading">
    <div class="section-heading"><h2 id="photos-heading">Event photos.</h2><p>The moments between the dust settling.<br/>A look at the ride, one frame at a time.</p></div>
    <div class="photo-carousel" role="region" aria-roledescription="carousel" aria-label="Event photos">
    <div id="event-photo-track" class:list={['photo-gallery', { 'single-photo': eventPhotos.length === 1 }]} tabindex="0" aria-label="Event photos — swipe, scroll, or use left and right arrow keys">
      {eventPhotos.map((photo, index) => <figure role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${eventPhotos.length}`}>
        <a href={photo.image} target="_blank" rel="noopener noreferrer" aria-label={`View full-size photo: ${photo.caption}`}><img src={photo.image} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy"/></a>
        <figcaption>{photo.caption}</figcaption>
      </figure>)}
    </div>
    <div class="photo-carousel-controls">
      <span data-photo-count aria-live="polite" aria-atomic="true">{eventPhotos.length ? 1 : 0} / {eventPhotos.length}</span>
      <div><button class="icon-button previous" type="button" data-photo-prev aria-controls="event-photo-track" aria-label="Previous event photo" disabled><Icon name="chevron"/></button><button class="icon-button" type="button" data-photo-next aria-controls="event-photo-track" aria-label="Next event photo" disabled={eventPhotos.length < 2}><Icon name="chevron"/></button></div>
    </div>
    </div>
  </section>
  <section id="swag" class="swag-section wrap" aria-labelledby="swag-heading">
    <div class="section-heading"><h2 id="swag-heading">MX Club Ranch Swag.</h2><p>Off the bike. Still part of the ride.<br/>Wear a little ranch wherever you go.</p></div>
    <div class="swag-grid">
      {swagItems.map(item => <article class="swag-item">
        <div class="swag-photo"><img src={item.image} alt={item.imageAlt} width={item.width} height={item.height} loading="lazy"/></div>
        <h3>{item.name}</h3><p>{item.description}</p>
      </article>)}
    </div>
    <p class="swag-order-note">Pricing and ordering details coming soon.</p>
  </section>
  <section id="contact" class="contact-section wrap" aria-labelledby="contact-heading"><div><h2 id="contact-heading">Good rides start<br/>with a <em>hello.</em></h2><p>Questions about training or a day at the ranch?<br/>We’d love to hear from you.</p></div><div class="contact-details"><div><h3>Give us a call</h3>{site.phone ? <a href={phoneHref}>{site.phone}</a> : <p>Phone number coming soon</p>}</div><div><h3>Drop us a line</h3>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <p>Email address coming soon</p>}</div><div><h3>Follow the ride</h3><div class="social-links">{site.facebook ? <a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook <Icon name="external"/></a> : <span>Facebook · coming soon</span>}{site.instagram ? <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram <Icon name="external"/></a> : <span>Instagram · coming soon</span>}</div></div></div></section>
</main>
<footer class="site-footer"><div class="wrap footer-main"><div class="footer-info"><a href="#" class="footer-name">MX CLUB RANCH</a><p>More time on the bike.<br/>More stories to bring home.</p><address>{site.address || 'Ranch address coming soon'}{site.phone && <a href={phoneHref}>{site.phone}</a>}{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}</address>{site.instagram && <a class="footer-instagram" href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Follow @clubranchmx on Instagram"><Icon name="instagram"/><span>@clubranchmx</span></a>}{site.directionsUrl && <a class="text-link" href={site.directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <Icon name="external"/></a>}</div><div class="footer-map">{site.mapEmbedUrl ? <iframe title="MX Club Ranch location" src={site.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe> : <div class="map-pending"><Icon name="pin"/><h3>Meet us at the ranch.</h3><p>Our location and directions will be shared here soon.</p></div>}</div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} MX Club Ranch</span><nav aria-label="Footer navigation"><a href="#training">Training</a><a href="#events">Events</a><a href="#photos">Photos</a><a href="#swag">Swag</a><a href="#contact">Contact</a></nav><a href="#">Back to top <Icon class="up-arrow"/></a></div></footer>
<script>
  import '../scripts/page';
</script>
</body>
</html>
